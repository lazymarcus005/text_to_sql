LLM_PROVIDER_ALLOW=openrouter,openai,google_gemini   # openai | openrouter | gemini
OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxx
GOOGLE_API_KEY=OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxx

MODELS=openai/gpt-4o,openai/gpt-4.1-nano,openai/gpt-5-mini,openai/gpt-5.1-codex-mini,anthropic/claude-3.5-sonnet,google/gemini-2.5-flash

# DB (compose service name: db) - MariaDB
DB_HOST=db
DB_PORT=3306
DB_NAME=nocobase
DB_USER=app
DB_PASSWORD=app_pw

# Safety
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=200

# Text-to-SQL retries
TEXT2SQL_MAX_RETRIES=3